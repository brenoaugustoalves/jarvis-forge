# Opcional para a próxima etapa: provedor de IA
AI_PROVIDER=openrouter
AI_MODEL=
AI_API_KEY=
# Desenvolvimento local sem Docker:
DATABASE_URL=sqlite:///./jarvis-forge.db
# Docker/produção:
# DATABASE_URL=postgresql+psycopg://jarvis:jarvis_dev_only@localhost:5432/jarvis_forge
# Ative proteção da API em ambientes compartilhados:
# JARVIS_API_KEY=troque-por-um-segredo-forte
# Railway injeta PORT automaticamente; não defina manualmente.
# REDIS_URL=redis://... (quando o worker Redis for ativado)
